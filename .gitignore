# Android / Gradle build output. local.properties contains absolute SDK
# paths that leak the dev's $HOME; .gradle/ and build/ are regenerable
# per-machine. Keep these ignored at every nesting level since the repo
# has multiple Android modules (android-sdk, android-sample).
**/.gradle/
**/build/
**/local.properties
