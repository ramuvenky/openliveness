# Generated by XcodeGen on every invocation of `xcodegen generate`.
# Keeping the project file out of VCS avoids pbxproj merge pain and
# forces project.yml to be the single source of truth. The sibling
# android-sample's .gitignore has the same rationale for build/.
OpenLivenessSample.xcodeproj/

# Xcode / SwiftPM / xcodebuild local state. None of this is portable
# across machines — DerivedData alone is tens of MB per build and
# changes every compile.
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
.swiftpm/
Package.resolved

# fastlane artifacts, if a dev runs it locally. CI uploads from a clean
# runner so none of this needs to be checked in.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
