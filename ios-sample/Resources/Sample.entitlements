<?xml version="1.0" encoding="UTF-8"?>
<!--
  App Attest requires the `com.apple.developer.devicecheck.appattest-environment`
  entitlement. The value is used verbatim by DCAppAttestService at run
  time — it is NOT rewritten by export options or by Apple's signing
  pipeline, contrary to what an earlier revision of this file claimed.
  (Review fix H-2.)

  `development` means both local and TestFlight builds talk to Apple's
  development attestation endpoints. That is intentional for a dev
  harness: the development endpoints are more lax about key
  freshness and let an internal tester re-register without burning
  through assertion quotas on the production service. A real
  production app would ship with `production` here and accept the
  stricter quotas.

  App Attest is unavailable on the Simulator — `DCAppAttestService.isSupported`
  returns false there — so SDK startup on a sim run falls through to
  `.unsupported` and the attestation bucket on the relay shows as
  `unsupported`, not `failed`. Running on a real device via TestFlight
  is the only path that exercises the full attestation flow.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.devicecheck.appattest-environment</key>
    <string>development</string>
</dict>
</plist>
