# OpenLiveness relay environment template.
# Copy to `.env` and fill in before `pnpm dev` or `docker compose up`.
# Every variable the relay reads from process.env is listed below.

# --- Server ---------------------------------------------------------------
# HTTP port the relay listens on.
PORT=3000
# Public hostname (and optional port) the browser/phone SDKs reach us at.
# In production this is the TLS-terminated hostname; dev defaults to localhost.
RELAY_BASE_URL=localhost
# "development" | "production". Several guards (webhook scheme, hardware
# stub, weak-secret refusal) key off this.
NODE_ENV=development
# pino log level. Omit to use "info".
LOG_LEVEL=info

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Set only if your Redis requires AUTH.
REDIS_PASSWORD=

# --- Relay signing keypair (ES256 / prime256v1) --------------------------
# Generate with `./gen-keys.sh` or `openssl ecparam -genkey -name prime256v1`.
# The private key must never leave the host; both keys live outside the repo
# (keys/ is gitignored).
JWT_PRIVATE_KEY_PATH=./keys/relay-private.pem
JWT_PUBLIC_KEY_PATH=./keys/relay-public.pem

# --- Apple App Attest (iOS) ----------------------------------------------
# From developer.apple.com → your team page.
APPLE_TEAM_ID=
# Bundle ID of the iOS app that will submit App Attest proofs.
APPLE_APP_BUNDLE_ID=
# PEM of Apple's App Attest root CA. Required in production — the relay
# refuses an unverifiable chain. In dev an unset path skips the chain check
# and logs a boot warn.
APPLE_APP_ATTEST_ROOT_CA_PATH=

# --- Google Play Integrity (Android) -------------------------------------
# Full package name of the Android app, e.g. com.example.yourapp.
GOOGLE_PLAY_PACKAGE_NAME=
# Service-account JSON that can call playintegrity.googleapis.com. The file
# itself is loaded by googleapis via the GOOGLE_APPLICATION_CREDENTIALS env.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Session + attestation lifetimes -------------------------------------
# Minutes a session is valid for before expires_at.
SESSION_EXPIRY_MINUTES=5
# Maximum age of the attestation's `timestamp` claim at /complete time.
ATTESTATION_MAX_AGE_SECONDS=120

# --- Hardware attestation gate -------------------------------------------
# "enforce" | "stub". stub turns verifyHardware into an unconditional pass
# — useful for CI and the phone team's local work, refused at boot when
# NODE_ENV=production.
HARDWARE_ATTESTATION=stub

# --- Secrets --------------------------------------------------------------
# HMAC key for Play Integrity nonces. REQUIRED in production, and the relay
# refuses to start with a well-known placeholder (e.g. this template value).
# Rotate by generating `openssl rand -hex 32`.
INTEGRITY_NONCE_SECRET=
# HMAC key for webhook body signatures (X-OpenLiveness-Signature). If unset
# the relay logs and skips webhook delivery rather than sending a forgeable
# unsigned body.
WEBHOOK_SIGNING_SECRET=
# HMAC key for pseudonymizing client IPs in logs. REQUIRED in production;
# an unset secret logs a boot warn and uses "" (unkeyed) so log pseudonyms
# are reversible with a rainbow table.
IP_HASH_SECRET=

# --- Network trust -------------------------------------------------------
# Set to "true" ONLY when there's a trusted proxy / LB in front of the relay
# that writes X-Forwarded-For. Otherwise any client can forge the header and
# escape per-IP rate limits.
TRUST_PROXY=false
# Set to "true" to allow http://localhost webhooks. Dev-only. Any other value
# (unset, "false", "1") disables loopback webhooks.
ALLOW_LOOPBACK_WEBHOOKS=false
