{
  "name": "@openliveness/verify",
  "version": "0.1.1",
  "description": "Server-side verification for openliveness attestation JWTs. Check that a signed liveness proof is legitimate — on Node, edge runtimes, or in the browser — without ever processing biometric data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramuvenky/openliveness.git",
    "directory": "verify"
  },
  "homepage": "https://github.com/ramuvenky/openliveness#readme",
  "bugs": "https://github.com/ramuvenky/openliveness/issues",
  "keywords": [
    "liveness",
    "liveness-detection",
    "face-liveness",
    "presentation-attack-detection",
    "pad",
    "anti-spoofing",
    "deepfake-detection",
    "jwt",
    "jwt-verification",
    "jwks",
    "attestation",
    "kyc",
    "ial2",
    "nist-800-63",
    "biometrics",
    "privacy",
    "gdpr",
    "hardware-attestation",
    "openliveness"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.lint.json"
  },
  "dependencies": {
    "jose": "^5.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
