{
  "name": "@openliveness/web",
  "version": "0.1.1",
  "description": "Browser SDK for openliveness — liveness verification where biometric data never leaves the user's phone. Proves there is a real live human in front of the camera without sending video, photos, or face embeddings to a server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramuvenky/openliveness.git",
    "directory": "web-sdk"
  },
  "homepage": "https://github.com/ramuvenky/openliveness#readme",
  "bugs": "https://github.com/ramuvenky/openliveness/issues",
  "keywords": [
    "liveness",
    "liveness-detection",
    "face-liveness",
    "presentation-attack-detection",
    "pad",
    "anti-spoofing",
    "deepfake-detection",
    "injection-attack",
    "kyc",
    "ial2",
    "nist-800-63",
    "biometrics",
    "privacy",
    "gdpr",
    "hardware-attestation",
    "app-attest",
    "play-integrity",
    "cross-device",
    "qr-code",
    "openliveness"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/LivenessWidget.d.ts",
      "default": "./dist/react/LivenessWidget.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.lint.json"
  },
  "dependencies": {
    "qrcode": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
